# Hercules Agent Environment Configuration
# All tools included, messaging/web CLI layer removed

# =============================================================================
# HERCULES CORE (Offline-First Mode Available)
# =============================================================================
# Hercules is fully functional without any API keys.
# Set HERCULES_MODE to "offline" for zero-dependency operation.
#
# Modes:
#   offline    — No external APIs. Uses only local models and memory.
#   hybrid     — Preferred. Uses local when possible, APIs when needed (default).
#   api        — All operations via API (requires API keys below).
#
# HERCULES_MODE=hybrid

# Optional: Local model support (when using offline mode)
# Supported: phi-2, mistral-7b, llama-2, neural-chat, ggml-models
# LOCAL_MODEL_PATH=${HOME}/.hercules/models/phi-2

# =============================================================================
# PERSISTENT MEMORY (Always Enabled - Local Only)
# =============================================================================
# All conversations and learned patterns stored at ~/.hercules/memory/
# No cloud sync, no external storage, no telemetry

# =============================================================================
# LLM PROVIDER (Fireworks AI)
# =============================================================================
# Get your key at: https://app.fireworks.ai/settings/users/api-keys
# FIREWORKS_API_KEY=

# =============================================================================
# LLM PROVIDER (OpenRouter)
# =============================================================================
# Get your key at: https://openrouter.ai/keys
# OPENROUTER_API_KEY=

# =============================================================================
# LLM PROVIDER (NovitaAI)
# =============================================================================
# Get your key at: https://novita.ai/settings/key-management
# NOVITA_API_KEY=
# NOVITA_BASE_URL=https://api.novita.ai/openai/v1

# =============================================================================
# LLM PROVIDER (Google AI Studio / Gemini)
# =============================================================================
# Get your key at: https://aistudio.google.com/app/apikey
# GOOGLE_API_KEY=
# GEMINI_API_KEY=

# =============================================================================
# LLM PROVIDER (Ollama Cloud)
# =============================================================================
# Get your key at: https://ollama.com/settings
# OLLAMA_API_KEY=

# =============================================================================
# LLM PROVIDER (z.ai / GLM)
# =============================================================================
# Get your key at: https://z.ai or https://open.bigmodel.cn
# GLM_API_KEY=

# =============================================================================
# LLM PROVIDER (Kimi / Moonshot)
# =============================================================================
# Get your key at: https://platform.kimi.ai
# KIMI_API_KEY=

# =============================================================================
# LLM PROVIDER (Arcee AI)
# =============================================================================
# Get an Arcee key at: https://chat.arcee.ai/
# ARCEEAI_API_KEY=

# =============================================================================
# LLM PROVIDER (MiniMax)
# =============================================================================
# Get your key at: https://www.minimax.io
# MINIMAX_API_KEY=

# =============================================================================
# LLM PROVIDER (OpenCode Zen)
# =============================================================================
# Get your key at: https://opencode.ai/auth
# OPENCODE_ZEN_API_KEY=

# =============================================================================
# LLM PROVIDER (OpenCode Go)
# =============================================================================
# Get your key at: https://opencode.ai/auth
# OPENCODE_GO_API_KEY=

# =============================================================================
# LLM PROVIDER (Hugging Face Inference)
# =============================================================================
# Get your token at: https://huggingface.co/settings/tokens
# HF_TOKEN=

# =============================================================================
# LLM PROVIDER (Qwen OAuth)
# =============================================================================
# Uses local ~/.qwen/oauth_creds.json (run: qwen auth qwen-oauth)
# No API key needed

# =============================================================================
# LLM PROVIDER (Xiaomi MiMo)
# =============================================================================
# Get your key at: https://platform.xiaomimimo.com
# XIAOMI_API_KEY=

# =============================================================================
# TOOL API KEYS (All Local-Use Tools)
# =============================================================================

# Exa API Key - AI-native web search and contents
# Get at: https://exa.ai
# EXA_API_KEY=

# Parallel API Key - AI-native web search and extract
# Get at: https://parallel.ai
# PARALLEL_API_KEY=

# Firecrawl API Key - Web search, extract, and crawl
# Get at: https://firecrawl.dev/
# FIRECRAWL_API_KEY=

# FAL.ai API Key - Image generation
# Get at: https://fal.ai/
# FAL_KEY=

# Honcho - Cross-session AI-native user modeling
# Get at: https://app.honcho.dev
# HONCHO_API_KEY=

# =============================================================================
# HYPERLIQUID OPTIONAL SKILL
# =============================================================================
# Optional defaults for blockchain/hyperliquid skill
# HYPERLIQUID_API_URL=https://api.hyperliquid.xyz
# HYPERLIQUID_USER_ADDRESS=0x0000000000000000000000000000000000000000

# =============================================================================
# TERMINAL TOOL CONFIGURATION
# =============================================================================
# Backend: "local" (default), "docker", "singularity", "modal", or "ssh"
# Configure in ~/.hercules/config.yaml (terminal.backend) or override here:
# TERMINAL_ENV=local

# Override container runtime (e.g., use Podman instead of Docker)
# HERCULES_DOCKER_BINARY=/usr/local/bin/podman

# Container images
# TERMINAL_DOCKER_IMAGE=nikolaik/python-nodejs:python3.11-nodejs20
# TERMINAL_SINGULARITY_IMAGE=docker://nikolaik/python-nodejs:python3.11-nodejs20
TERMINAL_MODAL_IMAGE=nikolaik/python-nodejs:python3.11-nodejs20

# Working directory for terminal commands
# TERMINAL_CWD=.

# Default command timeout (seconds)
TERMINAL_TIMEOUT=60

# Cleanup inactive environments after this many seconds
TERMINAL_LIFETIME_SECONDS=300

# =============================================================================
# SSH REMOTE EXECUTION (for TERMINAL_ENV=ssh)
# =============================================================================
# Run terminal commands on a remote server via SSH
#
# TERMINAL_SSH_HOST=192.168.1.100
# TERMINAL_SSH_USER=agent
# TERMINAL_SSH_PORT=22
# TERMINAL_SSH_KEY=~/.ssh/id_rsa

# =============================================================================
# SUDO SUPPORT (works with ALL terminal backends)
# =============================================================================
# If set, enables sudo commands by piping password via `sudo -S`.
# SECURITY WARNING: Password stored in plaintext. Local-only systems only.
#
# SUDO_PASSWORD=your_password_here

# =============================================================================
# BROWSER TOOL CONFIGURATION (Programmatic Use Only)
# =============================================================================
# Browser automation for programmatic tasks (no web CLI or user-facing interface)
#
# Browserbase API Key - Cloud browser execution
# Get at: https://browserbase.com/
# BROWSERBASE_API_KEY=

# Browserbase Project ID
# BROWSERBASE_PROJECT_ID=

# Enable residential proxies for better CAPTCHA solving (default: true)
BROWSERBASE_PROXIES=true

# Enable advanced stealth mode (requires Scale Plan)
BROWSERBASE_ADVANCED_STEALTH=false

# Browser engine: "auto" (Chrome) | "lightpanda" | "chrome"
# AGENT_BROWSER_ENGINE=auto

# Browser session timeout (seconds)
BROWSER_SESSION_TIMEOUT=300

# Browser inactivity timeout
BROWSER_INACTIVITY_TIMEOUT=120

# Camofox local anti-detection browser
# CAMOFOX_URL=http://localhost:9377

# =============================================================================
# SESSION LOGGING (All Local)
# =============================================================================
# Session trajectories automatically saved to logs/ directory
# Format: logs/session_YYYYMMDD_HHMMSS_UUID.json

# =============================================================================
# VOICE TOOLS (Optional - Local or Cloud)
# =============================================================================
# Speech-to-text: Local faster-whisper (default, no key needed)
# Requires: pip install faster-whisper
# Model downloads automatically (~150 MB for base)

# OpenAI API Key - For Whisper transcription and TTS (if not using local)
# Get at: https://platform.openai.com/api-keys
# VOICE_TOOLS_OPENAI_KEY=

# Groq API key - Free tier for Whisper STT
# GROQ_API_KEY=

# ElevenLabs API key - Cloud STT/TTS
# ELEVENLABS_API_KEY=

# STT Provider selection
# Default: "local" (faster-whisper) — no API key needed
# Configure in ~/.hercules/config.yaml (stt.provider)

# =============================================================================
# DEBUG OPTIONS (All Local)
# =============================================================================
WEB_TOOLS_DEBUG=false
VISION_TOOLS_DEBUG=false
MOA_TOOLS_DEBUG=false
IMAGE_TOOLS_DEBUG=false

# =============================================================================
# CONTEXT COMPRESSION (Auto-shrinks conversations)
# =============================================================================
# Uses local model for summary (phi-2 or configured LOCAL_MODEL_PATH)
CONTEXT_COMPRESSION_ENABLED=true
CONTEXT_COMPRESSION_THRESHOLD=0.85

# =============================================================================
# SKILLS HUB (GitHub integration for skill search/install)
# =============================================================================
# GitHub Personal Access Token — for higher API rate limits
# Get at: https://github.com/settings/tokens
# GITHUB_TOKEN=

# GitHub App credentials (optional — for bot identity)
# GITHUB_APP_ID=
# GITHUB_APP_PRIVATE_KEY_PATH=
# GITHUB_APP_INSTALLATION_ID=

# =============================================================================
# HUMAN-LIKE RESPONSE PACING
# =============================================================================
# Delays between message chunks (no messaging integrations, but available for custom skills)
# HERCULES_HUMAN_DELAY_MODE=off     # off | natural | custom
# HERCULES_HUMAN_DELAY_MIN_MS=800   # Min delay in ms (custom mode)
# HERCULES_HUMAN_DELAY_MAX_MS=2500  # Max delay in ms (custom mode)

# =============================================================================
# WHAT'S NOT INCLUDED (By Design)
# =============================================================================
# ❌ No messaging integrations (Slack, Telegram, Discord, Teams, etc.)
# ❌ No messaging platform APIs
# ❌ No gateway services or web CLI
# ❌ No user-facing web interface
# ❌ No email/chat platform connections
# ❌ No telemetry or analytics
#
# All tools available programmatically. For user-facing chat or messaging,
# use skills or other interfaces that layer on top of these local tools.

# =============================================================================
# GETTING STARTED
# =============================================================================
# 1. Clone: git clone https://github.com/mintoriakamoto/Hercules
# 2. Setup: ./setup-hercules.sh
# 3. Use programmatically or build custom interfaces
#
# All tools available. No CLI or web interface included by default.
# Build what you need on top using skills and custom code.
