# Hercules Agent Environment Configuration
# All tools included. No messaging integrations or web service layer.

# =============================================================================
# HERCULES CORE (Offline-First, No API Keys Needed)
# =============================================================================

# Operation mode: offline (no APIs), hybrid (smart selection), api (full APIs)
HERCULES_MODE=offline

# Local model path (optional, for offline reasoning)
# Supports: phi-2, mistral-7b, llama-2, neural-chat
# Downloads automatically on first use
# LOCAL_MODEL_PATH=${HOME}/.hercules/models/phi-2

# =============================================================================
# PERSISTENT MEMORY (Always Enabled)
# =============================================================================
# All conversations and learned patterns stored locally at ~/.hercules/memory/
# No external storage, no telemetry, no cloud sync
# User has full control and visibility

# =============================================================================
# LLM PROVIDERS (Optional - All Available)
# =============================================================================
# Configure any LLM provider. All work with CLI and tools.
#
# Fireworks AI: https://app.fireworks.ai/settings/users/api-keys
# FIREWORKS_API_KEY=
#
# OpenRouter: https://openrouter.ai/keys
# OPENROUTER_API_KEY=
#
# NovitaAI: https://novita.ai/settings/key-management
# NOVITA_API_KEY=
#
# Google Gemini: https://aistudio.google.com/app/apikey
# GOOGLE_API_KEY=
#
# Ollama Cloud: https://ollama.com/settings
# OLLAMA_API_KEY=
#
# Kimi/Moonshot: https://platform.kimi.ai
# KIMI_API_KEY=
#
# Hugging Face: https://huggingface.co/settings/tokens
# HF_TOKEN=

# =============================================================================
# TOOL APIs (Optional - All Available)
# =============================================================================
# Web Search
# EXA_API_KEY=                    # Exa: https://exa.ai
# PARALLEL_API_KEY=               # Parallel: https://parallel.ai
# FIRECRAWL_API_KEY=              # Firecrawl: https://firecrawl.dev/

# Image Generation
# FAL_KEY=                         # FAL.ai: https://fal.ai/

# Browser Automation (Programmatic Use Only)
# BROWSERBASE_API_KEY=            # Browserbase: https://browserbase.com/
# BROWSERBASE_PROJECT_ID=

# User Modeling
# HONCHO_API_KEY=                 # Honcho: https://app.honcho.dev

# GitHub Integration
# GITHUB_TOKEN=                   # https://github.com/settings/tokens

# Voice Tools (Optional)
# VOICE_TOOLS_OPENAI_KEY=         # OpenAI: https://platform.openai.com/api-keys
# GROQ_API_KEY=                   # Groq: https://groq.com
# ELEVENLABS_API_KEY=             # ElevenLabs: https://elevenlabs.io

# =============================================================================
# LOCAL VOICE (Optional - Like Mia)
# =============================================================================
# Speech-to-text: Uses local faster-whisper (no API key needed)
# Text-to-speech: Uses local pyttsx3 or espeak (no API key needed)
# Requires: pip install faster-whisper
# Model downloads automatically (~150 MB for base model)

# Override default STT model if needed
# STT_LOCAL_MODEL=base  # tiny, base, small, medium, large

# =============================================================================
# LOCAL VISION (Optional - Like Mia)
# =============================================================================
# Camera/webcam support via OpenCV (local, no cloud)
# Can process images locally without sending anywhere

# =============================================================================
# LOCAL TOOLS (Always Available)
# =============================================================================
# Terminal commands (sandboxed, local execution)
# File operations (local filesystem)
# Code execution (local, Python/Node/etc)
# Memory operations (local JSON stores)

# Terminal backend: local (default) | docker | singularity | modal | ssh
TERMINAL_ENV=local

# Terminal timeout (seconds)
TERMINAL_TIMEOUT=60

# =============================================================================
# LOCAL WEB INTERFACE (Optional - Like Mia's Flask Bridge)
# =============================================================================
# Run as: hercules web
# Serves HTTP locally on port 5000
# No external dependencies, no cloud backend
# HERCULES_WEB_PORT=5000
# HERCULES_WEB_HOST=127.0.0.1  # localhost only by default (security)

# =============================================================================
# SUDO SUPPORT (For Local Elevated Commands)
# =============================================================================
# Enable passwordless sudo for specific local commands
# SECURITY WARNING: Password stored in plaintext - local-only systems only
#
# Better alternatives:
# - Configure /etc/sudoers for specific commands
# - Run Hercules container as root
# - Use local SSH backend with passwordless sudo on remote
#
# SUDO_PASSWORD=your_password_here

# =============================================================================
# DEBUG & LOGGING (All Local)
# =============================================================================
WEB_TOOLS_DEBUG=false
VISION_TOOLS_DEBUG=false
MOA_TOOLS_DEBUG=false
IMAGE_TOOLS_DEBUG=false

# =============================================================================
# CONTEXT COMPRESSION (Auto-shrinks conversations)
# =============================================================================
# When conversation gets long, middle turns are summarized locally
# Uses local model for summary (phi-2 or configured LOCAL_MODEL_PATH)
CONTEXT_COMPRESSION_ENABLED=true
CONTEXT_COMPRESSION_THRESHOLD=0.85

# =============================================================================
# ETHIC AL PRINCIPLES (Always Active - Like Mia's Dreams)
# =============================================================================
# Seven core principles guide all Hercules behavior:
#
# 1. No API Dependency
#    Fully functional without external APIs or services
#    Can be deployed air-gapped, offline, isolated
#
# 2. Transparent Operations
#    All actions logged locally and auditable
#    No hidden behaviors, analytics, or telemetry
#
# 3. Ethical Constraints
#    Never assists with harm or deception
#    Respects privacy and user autonomy
#    Follows user's intent, not corporate goals
#
# 4. User Autonomy
#    Users control all features and behavior
#    Can fork, modify, redistribute freely
#    No forced updates or feature restrictions
#
# 5. Learning & Evolution
#    Persistent local memory retains conversations
#    Learns patterns from interactions over time
#    Improves within user's own scope only
#
# 6. Security First
#    Completely sandboxed from external systems
#    Memory files restricted to user only (chmod 600/700)
#    No data leaves the local system without explicit action
#
# 7. Open Source
#    All code is inspectable and modifiable
#    Community contributions welcome
#    No proprietary lock-in or vendor restrictions

# =============================================================================
# OPTIONAL: SECURE REMOTE EXECUTION (Still Local Control)
# =============================================================================
# Run local Hercules commands on a remote server via SSH
# Agent code stays on your machine, commands execute remotely
# Good for distributed testing, not for external API dependency
#
# TERMINAL_SSH_HOST=192.168.1.100
# TERMINAL_SSH_USER=agent
# TERMINAL_SSH_PORT=22
# TERMINAL_SSH_KEY=~/.ssh/id_rsa

# =============================================================================
# WHAT'S INCLUDED (By Design)
# =============================================================================
# ✅ Full CLI (hercules command)
# ✅ All read/write/execute tools
# ✅ Terminal execution (local/docker/ssh)
# ✅ File operations (full filesystem access)
# ✅ Code execution (Python/Node/Shell)
# ✅ Web search APIs (Exa, Parallel, Firecrawl)
# ✅ Image generation (FAL.ai)
# ✅ All LLM providers (optional)
# ✅ Browser automation (Browserbase, optional)
# ✅ Persistent local memory (~/.hercules/memory/)
# ✅ Local voice/vision support (optional)
# ✅ Skills system (modular, auditable)

# =============================================================================
# WHAT'S NOT INCLUDED (By Design)
# =============================================================================
# ❌ Messaging integrations (Slack, Telegram, Discord, Teams, Email, etc.)
# ❌ Web service layer (no local HTTP endpoint)
# ❌ Gateway services (no messaging bridges)
# ❌ Telemetry or analytics
# ❌ Cloud sync or external authentication
#
# WHY? Like Mia, Hercules is self-contained and autonomous.
# No background services. No calling home. No external dependencies.
# All capabilities available via CLI and local tools only.

# =============================================================================
# GETTING STARTED
# =============================================================================
# 1. Clone: git clone https://github.com/mintoriakamoto/Hercules
# 2. Setup: ./setup-hercules.sh
# 3. Use:   hercules
#
# Full CLI available. All tools accessible.
# No API keys required for offline mode.
# No messaging integrations or web services.
# Pure, autonomous, yours.
