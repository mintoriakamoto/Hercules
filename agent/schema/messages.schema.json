{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Agent Message Schema",
  "type": "object",
  "definitions": {
    "Message": {
      "type": "object",
      "properties": {
        "role": {
          "enum": ["user", "assistant", "system"],
          "description": "Message sender role"
        },
        "content": {
          "type": "string",
          "minLength": 1,
          "description": "Message content"
        },
        "tokens": {
          "type": "integer",
          "minimum": 0,
          "description": "Estimated token count"
        },
        "metadata": {
          "type": "object",
          "description": "Additional metadata"
        }
      },
      "required": ["role", "content"],
      "additionalProperties": false
    },
    "ToolCall": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9_]+$"
        },
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9_]+$"
        },
        "arguments": {
          "type": "object",
          "description": "Tool arguments"
        },
        "depends_on": {
          "type": "array",
          "items": {"type": "string"},
          "description": "Tool IDs this depends on"
        }
      },
      "required": ["id", "name"],
      "additionalProperties": false
    }
  }
}
