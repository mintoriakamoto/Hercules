# Hercules Unrestricted Mode Configuration
# Disables all optional safety checks and approval gates
# Use only in trusted, isolated, or development environments

# ============================================================================
# APPROVAL GATES - Auto-approve all dangerous operations
# ============================================================================
HERCULES_AUTO_APPROVE_EXEC=1
HERCULES_AUTO_APPROVE_PATCH=1
HERCULES_AUTO_APPROVE_FILE_WRITE=1
HERCULES_AUTO_APPROVE_DELETE=1

# ============================================================================
# OUTPUT PROCESSING - No credential redaction or filtering
# ============================================================================
HERCULES_DISABLE_OUTPUT_REDACTION=1
HERCULES_DISABLE_CREDENTIAL_MASKING=1
HERCULES_DISABLE_SENSITIVE_DATA_FILTERING=1

# ============================================================================
# SAFETY CHECKS - Skip all verification and validation
# ============================================================================
HERCULES_SKILLS_GUARD_ENABLED=0
HERCULES_DISABLE_CONFIG_VALIDATION=1
HERCULES_SKIP_PERMISSION_CHECKS=1
HERCULES_SKIP_CAPABILITY_VALIDATION=1

# ============================================================================
# RESOURCE LIMITS - Disable all constraints
# ============================================================================
HERCULES_DISABLE_CGROUP_DETECTION=1
HERCULES_FORCE_MAX_TOKENS=128000
HERCULES_UNLIMITED_HISTORY=1
HERCULES_DISABLE_MEMORY_LIMITS=1
HERCULES_DISABLE_TOKEN_LIMITS=1

# ============================================================================
# TIMEOUTS - Disable or maximize timeouts
# ============================================================================
HERCULES_GATEWAY_PROMPT_TIMEOUT=3600
HERCULES_IDLE_TIMEOUT=3600
HERCULES_SSH_CONNECT_TIMEOUT=60
HERCULES_DISABLE_IDLE_TIMEOUT=1

# ============================================================================
# ISOLATION & BACKENDS - Use local, non-isolated execution
# ============================================================================
HERCULES_TERMINAL_BACKEND=local
HERCULES_DISABLE_SANDBOX=1
HERCULES_DISABLE_CONTAINER_ISOLATION=1
HERCULES_FORCE_LOCAL_EXECUTION=1

# ============================================================================
# LOGGING & DEBUGGING - Full visibility and debug output
# ============================================================================
HERCULES_DEBUG=1
HERCULES_VERBOSE=1
HERCULES_LOG_LEVEL=DEBUG
HERCULES_ENABLE_TRACE_LOGGING=1
HERCULES_LOG_ALL_OPERATIONS=1

# ============================================================================
# GATEWAY & NETWORKING - No authentication or access control
# ============================================================================
HERCULES_DISABLE_GATEWAY_AUTH=1
HERCULES_DISABLE_ACCESS_CONTROL=1
HERCULES_DISABLE_RATE_LIMITING=1
HERCULES_ALLOW_UNAUTHENTICATED_GATEWAY=1
HERCULES_DISABLE_FIREWALL_CHECKS=1

# ============================================================================
# SESSIONS & LOCKING - Concurrent sessions allowed, no locks
# ============================================================================
HERCULES_DISABLE_SESSION_LOCKING=1
HERCULES_ALLOW_CONCURRENT_SESSIONS=1
HERCULES_SKIP_LOCK_VALIDATION=1

# ============================================================================
# FEATURES - Enable everything, skip nothing
# ============================================================================
HERCULES_ENABLE_EXPERIMENTAL_FEATURES=1
HERCULES_ENABLE_BETA_FEATURES=1
HERCULES_ENABLE_ALL_EXPERIMENTAL=1
HERCULES_UNSTABLE_API=1

# ============================================================================
# PROVIDER SETTINGS - Unlimited usage of all providers
# ============================================================================
TENSELERATE_API_KEY=unrestricted
ANTHROPIC_API_KEY=${ANTHROPIC_API_KEY:-unrestricted}
OPENAI_API_KEY=${OPENAI_API_KEY:-unrestricted}

# ============================================================================
# SKILL & PLUGIN SETTINGS - Auto-install, no verification
# ============================================================================
HERCULES_AUTO_INSTALL_SKILLS=1
HERCULES_SKIP_SKILL_VERIFICATION=1
HERCULES_AUTO_LOAD_PLUGINS=1
HERCULES_SKIP_PLUGIN_VERIFICATION=1
HERCULES_DISABLE_SKILLS_SANDBOX=1

# ============================================================================
# DATA RETENTION - Keep everything, never delete
# ============================================================================
HERCULES_KEEP_ALL_LOGS=1
HERCULES_KEEP_ALL_HISTORY=1
HERCULES_NEVER_DELETE_SESSIONS=1
HERCULES_DISABLE_SESSION_CLEANUP=1
HERCULES_DISABLE_LOG_ROTATION=1

# ============================================================================
# PERFORMANCE - No throttling or rate limiting
# ============================================================================
HERCULES_DISABLE_RATE_LIMIT=1
HERCULES_DISABLE_BACKOFF=1
HERCULES_DISABLE_RETRY_DELAY=1
HERCULES_MAX_CONCURRENT_OPERATIONS=unlimited
HERCULES_DISABLE_THROTTLING=1

# ============================================================================
# ENCRYPTION & SECURITY - Minimal encryption (for development only)
# ============================================================================
HERCULES_DISABLE_ENCRYPTION=1
HERCULES_SKIP_TLS_VERIFICATION=0  # Keep this for safety with real APIs
HERCULES_ALLOW_INSECURE_TRANSPORT=1

# ============================================================================
# ADVANCED - Unsafe operations and developer overrides
# ============================================================================
HERCULES_ALLOW_UNSAFE_OPERATIONS=1
HERCULES_DEVELOPER_MODE=1
HERCULES_UNSAFE_MODE=1
HERCULES_BYPASS_ALL_SAFETY_CHECKS=1
